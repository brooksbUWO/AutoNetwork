  "keywords": [
    "wifi",
    "esp32",
    "captive-portal",
    "connection-manager",
    "wpa2-enterprise",
    "async-webserver",
    "credential-storage",
    "auto-connect"
  ],
  "authors": [
    {
      "name": "Brooks",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/brooksbUWO/AutoNetwork.git"
  },
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "dependencies": [
    {
      "name": "ArduinoJson"
    },
    {
      "name": "AsyncTCP"
    }
  ],
  "export": {
    "include": [
      "src/*",
      "examples/*",
      "docs/*",
      "README.md",
      "LICENSE",
      "library.properties",
      "library.json"
    ]
  }
